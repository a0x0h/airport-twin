    "fetch:mhd": "node scripts/fetch-mhd.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0",
    "three-stdlib": "2.36.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
